# --- The address this app is served from (no trailing slash) ---
APP_URL=https://sign.tommyzhao.watch

# --- Your private pages ---
# The password for the private "New agreement" pages.
ADMIN_PASSWORD=choose-a-long-password
# Any long random string (at least 32 characters). Used to secure your login cookie.
SESSION_SECRET=replace-with-a-long-random-string

# --- DocuSeal ---
DOCUSEAL_API_KEY=
# Global cloud: https://api.docuseal.com and https://docuseal.com
# EU cloud:     https://api.docuseal.eu  and https://docuseal.eu
DOCUSEAL_API_URL=https://api.docuseal.com
DOCUSEAL_APP_URL=https://docuseal.com
# The secret you enter in DocuSeal's webhook settings (header name: X-Webhook-Secret).
DOCUSEAL_WEBHOOK_SECRET=replace-with-another-random-string

# --- Who countersigns for the company ---
COMPANY_SIGNER_NAME=Tommy Zhao
COMPANY_SIGNER_TITLE=Director
COMPANY_SIGNER_EMAIL=tommy@tommyzhao.watch
# Your typed signature goes on the form when it is sent. Set to false to countersign each one instead.
COMPANY_PRESIGN=true

# --- Emails (sent through Resend: https://resend.com) ---
RESEND_API_KEY=
EMAIL_FROM=Tommy Zhao · No. 67 <tommy@tommyzhao.watch>
EMAIL_REPLY_TO=tommy@tommyzhao.watch
